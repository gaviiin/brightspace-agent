{
  "manifest_version": 3,
  "name": "BrightSpace Agent",
  "version": "0.1.0",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1:8730/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
